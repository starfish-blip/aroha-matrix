const express = require('express');
const path = require('path');
const app = express();
const PORT = process.env.PORT || 3013;

app.use(express.static(path.join(__dirname)));

app.get('/health', (req, res) => {
  res.json({ status: 'ok', service: 'aroha-matrix', timestamp: new Date().toISOString() });
});

app.listen(PORT, () => {
  console.log('AROHA Matrix server running on port ' + PORT);
});
